### Register
POST http://localhost:3000/auth/register
Content-Type: application/json

{
  "email": "test@couvrini.com",
  "password": "Test1234!",
  "firstName": "Test",
  "lastName": "User",
  "role": "WORKER"
}
### Login
POST http://localhost:3000/auth/login
Content-Type: application/json

{
  "email": "test@couvrini.com",
  "password": "Test1234!"
}
### Get current user
GET http://localhost:3000/auth/me
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjEsImVtYWlsIjoidGVzdEBjb3V2cmluaS5jb20iLCJyb2xlIjoiV09SS0VSIiwiaWF0IjoxNzg2OTE4MTIzLCJleHAiOjE3ODc1MjI5MjN9.W8Mfze8LpDhj5TpvPs5dPQjAKvH2OojyqAEiLiSAHHI

##################################################
### WORKERS MODULE
##################################################

### 1. Create worker profile
POST http://localhost:3000/workers/profile
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjEsImVtYWlsIjoidGVzdEBjb3V2cmluaS5jb20iLCJyb2xlIjoiV09SS0VSIiwiaWF0IjoxNzg2OTE4MTIzLCJleHAiOjE3ODc1MjI5MjN9.W8Mfze8LpDhj5TpvPs5dPQjAKvH2OojyqAEiLiSAHHI
Content-Type: application/json

{
  "bio": "Experienced worker with 5 years in the industry",
  "resumeUrl": "https://example.com/resume.pdf",
  "yearsOfExperience": 5
}

### 2. Get worker profile
GET http://localhost:3000/workers/profile
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjEsImVtYWlsIjoidGVzdEBjb3V2cmluaS5jb20iLCJyb2xlIjoiV09SS0VSIiwiaWF0IjoxNzg2OTE4MTIzLCJleHAiOjE3ODc1MjI5MjN9.W8Mfze8LpDhj5TpvPs5dPQjAKvH2OojyqAEiLiSAHHI

### 3. Update worker profile
PUT http://localhost:3000/workers/profile
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjEsImVtYWlsIjoidGVzdEBjb3V2cmluaS5jb20iLCJyb2xlIjoiV09SS0VSIiwiaWF0IjoxNzg2OTE4MTIzLCJleHAiOjE3ODc1MjI5MjN9.W8Mfze8LpDhj5TpvPs5dPQjAKvH2OojyqAEiLiSAHHI
Content-Type: application/json

{
  "bio": "Updated bio with more experience",
  "yearsOfExperience": 6
}

### 4. Add skill to worker profile
POST http://localhost:3000/workers/skills
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjEsImVtYWlsIjoidGVzdEBjb3V2cmluaS5jb20iLCJyb2xlIjoiV09SS0VSIiwiaWF0IjoxNzg2OTE4MTIzLCJleHAiOjE3ODc1MjI5MjN9.W8Mfze8LpDhj5TpvPs5dPQjAKvH2OojyqAEiLiSAHHI
Content-Type: application/json

{
  "skillId": 1
}

### 5. Remove skill from worker profile
DELETE http://localhost:3000/workers/skills/1
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjEsImVtYWlsIjoidGVzdEBjb3V2cmluaS5jb20iLCJyb2xlIjoiV09SS0VSIiwiaWF0IjoxNzg2OTE4MTIzLCJleHAiOjE3ODc1MjI5MjN9.W8Mfze8LpDhj5TpvPs5dPQjAKvH2OojyqAEiLiSAHHI

### 6. Add category preference to worker profile
POST http://localhost:3000/workers/categories
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjEsImVtYWlsIjoidGVzdEBjb3V2cmluaS5jb20iLCJyb2xlIjoiV09SS0VSIiwiaWF0IjoxNzg2OTE4MTIzLCJleHAiOjE3ODc1MjI5MjN9.W8Mfze8LpDhj5TpvPs5dPQjAKvH2OojyqAEiLiSAHHI
Content-Type: application/json

{
  "categoryId": 1
}

### 7. Remove category preference from worker profile
DELETE http://localhost:3000/workers/categories/1
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjEsImVtYWlsIjoidGVzdEBjb3V2cmluaS5jb20iLCJyb2xlIjoiV09SS0VSIiwiaWF0IjoxNzg2OTE4MTIzLCJleHAiOjE3ODc1MjI5MjN9.W8Mfze8LpDhj5TpvPs5dPQjAKvH2OojyqAEiLiSAHHI

### 8. Create or update worker availability
POST http://localhost:3000/workers/availability
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjEsImVtYWlsIjoidGVzdEBjb3V2cmluaS5jb20iLCJyb2xlIjoiV09SS0VSIiwiaWF0IjoxNzg2OTE4MTIzLCJleHAiOjE3ODc1MjI5MjN9.W8Mfze8LpDhj5TpvPs5dPQjAKvH2OojyqAEiLiSAHHI
Content-Type: application/json

{
  "dayOfWeek": 1,
  "startTime": "09:00",
  "endTime": "17:00",
  "isAvailable": true
}

### 9. Get worker availability
GET http://localhost:3000/workers/availability
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjEsImVtYWlsIjoidGVzdEBjb3V2cmluaS5jb20iLCJyb2xlIjoiV09SS0VSIiwiaWF0IjoxNzg2OTE4MTIzLCJleHAiOjE3ODc1MjI5MjN9.W8Mfze8LpDhj5TpvPs5dPQjAKvH2OojyqAEiLiSAHHI

### 10. Delete worker profile
DELETE http://localhost:3000/workers/profile
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjEsImVtYWlsIjoidGVzdEBjb3V2cmluaS5jb20iLCJyb2xlIjoiV09SS0VSIiwiaWF0IjoxNzg2OTE4MTIzLCJleHAiOjE3ODc1MjI5MjN9.W8Mfze8LpDhj5TpvPs5dPQjAKvH2OojyqAEiLiSAHHI